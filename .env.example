# ---------------------------------------------------------------------------
# Micuppa Incident Agent — environment template. Copy to .env and fill in.
# Never commit real credentials (.env is git-ignored).
# ---------------------------------------------------------------------------

ENVIRONMENT=local

# Which routes this instance serves. `all` (default) runs everything in one
# process for local development. A Cloud Run deployment runs the same image
# twice: SERVICE_ROLE=api for the public incident/Grafana routes and
# SERVICE_ROLE=worker for the OIDC-protected Cloud Tasks worker and recovery.
# Cloud Run authenticates per service, so one service cannot be both public
# and worker-authenticated. See docs/deployment.md.
SERVICE_ROLE=all

# Local development defaults to SQLite and needs no further setup.
# Any non-local ENVIRONMENT must set a PostgreSQL URL: the application
# refuses to start on SQLite in a deployed environment.
DATABASE_URL=sqlite:///./incident_agent.db

# PostgreSQL only, and FIXED. The agent's tables live in this dedicated schema
# so they never collide with the host application's `public` tables. The value
# is validated: the Alembic migrations hard-code `incident_agent`, so any other
# value is rejected rather than silently diverging from the migrations.
# Changing the schema requires regenerating the migrations. Ignored for SQLite.
DATABASE_SCHEMA=incident_agent

# Supabase example. Use the connection *pooler* host and the psycopg driver
# (postgresql+psycopg://). Schema changes are applied explicitly, never at
# application startup. Preview the target first (prints host/port/db/user and
# whether a password is set, never the password itself):
#   .\.venv\Scripts\python.exe -m app.db.target
#   .\.venv\Scripts\python.exe -m alembic upgrade head
#
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#
# Least-privilege setup (run once as an owner/admin role):
#   CREATE ROLE incident_agent LOGIN PASSWORD '...';
#   -- After `alembic upgrade head` has created the schema and tables:
#   GRANT USAGE ON SCHEMA incident_agent TO incident_agent;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA incident_agent TO incident_agent;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA incident_agent
#     GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO incident_agent;
# The runtime role only needs DML on the agent tables. CREATE on the schema is
# only needed by whichever role runs the migrations.

GRAFANA_WEBHOOK_USERNAME=grafana-agent
GRAFANA_WEBHOOK_PASSWORD=replace-with-a-long-random-secret

# --- Incident-management API -------------------------------------------------
# HTTP Basic credentials for GET/POST /api/v1/incidents. A SEPARATE pair from
# the Grafana webhook: the webhook password is never a general API credential
# (and vice versa). Both values must be set or the incident API fails closed
# with 503; a wrong/missing credential is 401. During a Cloud Run deployment,
# keep INCIDENT_API_PASSWORD in Secret Manager and inject it with
# `--set-secrets`. See docs/deployment.md.
INCIDENT_API_USERNAME=incident-api
INCIDENT_API_PASSWORD=replace-with-a-different-long-random-secret
# --- Cloud Tasks dispatch ---------------------------------------------------
# Required to enqueue tasks. Dispatch fails fast (job stays `pending`, named
# in `last_error`) if any of these are missing. Nothing is hard-coded.
#   docs/cloud-tasks-deployment.md
GCP_PROJECT_ID=
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE=incident-investigations
# Full HTTPS URL of POST /api/v1/worker/investigate.
INVESTIGATION_WORKER_URL=
# The only service account the worker will accept a delivery token from.
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
# OIDC audience for both the token minted by the dispatcher and the worker's
# verification. Falls back to INVESTIGATION_WORKER_URL when empty, but that
# fallback includes the endpoint path while Cloud Run validates the service
# URL — set this explicitly (e.g. https://SERVICE.run.app) on Cloud Run.
INVESTIGATION_WORKER_AUDIENCE=

# --- Internal recovery -------------------------------------------------------
# Separate identity and audience so a task-delivery token can never trigger
# recovery.
RECOVERY_SERVICE_ACCOUNT_EMAIL=
RECOVERY_AUDIENCE=
INVESTIGATION_JOB_LEASE_SECONDS=900
